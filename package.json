{
  "name": "cronicle-mcp",
  "version": "0.1.0",
  "description": "MCP server for Cronicle — lets Claude create projects, schedule agent jobs, and monitor runs on your behalf.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cronicle-mcp": "./dist/server.js"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && chmod +x dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "examples"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "express": "^5.2.1",
    "jose": "^6.2.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "cronicle",
    "claude",
    "model-context-protocol",
    "scheduler",
    "agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jshiv/cronicle-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/jshiv/cronicle-mcp/issues"
  },
  "homepage": "https://github.com/jshiv/cronicle-mcp#readme"
}
